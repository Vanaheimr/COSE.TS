{
    "name": "@vanaheimr/cose",
    "version": "0.9.0",
    "description": "CBOR Object Signing and Encryption (RFC 9052) in TypeScript, on top of the Metrological CBOR codec — the TypeScript counterpart of Vanaheimr Styx's Illias/COSE.",
    "keywords": [
        "cose",
        "cbor",
        "rfc9052",
        "rfc9053",
        "cose-sign1",
        "signing",
        "encryption",
        "mac",
        "ecdsa",
        "eddsa",
        "ml-dsa",
        "post-quantum",
        "brainpool",
        "x509",
        "metrology",
        "smart-metering",
        "e-mobility"
    ],
    "homepage": "https://github.com/Vanaheimr/COSE.TS#readme",
    "bugs": {
        "url": "https://github.com/Vanaheimr/COSE.TS/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Vanaheimr/COSE.TS.git"
    },
    "license": "Apache-2.0",
    "author": "GraphDefined GmbH <achim.friedland@graphdefined.com>",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist",
        "README.md",
        "LICENSE.md",
        "NOTICE",
        "CHANGELOG.md"
    ],
    "sideEffects": false,
    "engines": {
        "node": ">=20"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "npm run build:js && npm run build:types && npm run build:finish",
        "build:js": "tsup",
        "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly",
        "build:finish": "tsx scripts/finish-build.ts",
        "clean": "node -e \"import('node:fs').then(fs => fs.rmSync('dist', { recursive: true, force: true }))\"",
        "docs:api": "typedoc",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:fuzz": "vitest run tests/fuzz",
        "typecheck": "tsc --noEmit && tsc -p tsconfig.browser.json",
        "verify": "npm run typecheck && npm run lint && npm run build && npm run test && npm run docs:api",
        "prepublishOnly": "npm run verify"
    },
    "dependencies": {
        "@noble/ciphers": "^2.4.0",
        "@noble/curves": "^2.4.0",
        "@noble/hashes": "^2.4.0",
        "@noble/post-quantum": "^0.7.1",
        "@vanaheimr/metrological-cbor": "^0.11.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^26.2.0",
        "@vitest/coverage-v8": "^5.0.0",
        "esbuild": "^0.28.2",
        "eslint": "^10.10.0",
        "fast-check": "^4.9.0",
        "globals": "^17.12.0",
        "tsup": "^8.5.1",
        "tsx": "^4.23.13",
        "typedoc": "^0.28.20",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.70.0",
        "vitest": "^5.0.0"
    }
}
