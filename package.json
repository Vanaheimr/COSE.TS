{
    "name": "@vanaheimr/cose",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "license": "Apache-2.0",
    "author": "GraphDefined GmbH <achim.friedland@graphdefined.com>",
    "description": "CBOR Object Signing and Encryption (RFC 9052) in TypeScript, on top of the Metrological CBOR codec — the TypeScript counterpart of Vanaheimr Styx's Illias/COSE.",
    "homepage": "https://github.com/Vanaheimr/COSE.TS#readme",
    "bugs": {
        "url": "https://github.com/Vanaheimr/COSE.TS/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Vanaheimr/COSE.TS.git"
    },
    "scripts": {
        "build": "npm run build:js && npm run build:types && npm run build:finish",
        "build:js": "tsup",
        "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly",
        "build:finish": "tsx scripts/finish-build.ts",
        "clean": "node -e \"import('node:fs').then(fs => fs.rmSync('dist', { recursive: true, force: true }))\"",
        "test": "vitest run",
        "typecheck": "tsc --noEmit && tsc -p tsconfig.browser.json"
    },
    "dependencies": {
        "@noble/ciphers": "^2.3.0",
        "@noble/curves": "^2.3.0",
        "@noble/hashes": "^2.3.0",
        "@noble/post-quantum": "^0.7.0",
        "@vanaheimr/metrological-cbor": "^0.10.0"
    },
    "devDependencies": {
        "@types/node": "^26.2.0",
        "esbuild": "^0.28.2",
        "tsup": "^8.5.1",
        "tsx": "^4.23.12",
        "typescript": "^6.0.3",
        "vitest": "^4.1.10"
    }
}
